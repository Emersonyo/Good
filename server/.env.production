# Production Environment Variables

# Server
PORT=4000
NODE_ENV=production

# MongoDB Atlas (production)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/emerson?retryWrites=true&w=majority

# OpenAI API
OPENAI_API_KEY=sk-your-prod-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# System prompt
SYSTEM_PROMPT=You are Emerson, an intelligent, helpful, respectful, knowledgeable AI assistant. You explain concepts simply and admit uncertainty when appropriate. You format responses cleanly using Markdown.

# CORS (allow frontend domain in production)
CORS_ORIGIN=https://emerson-frontend.vercel.app

# Session security (generate random strings)
SESSION_SECRET=your-random-session-secret-here
